# Google OAuth (client credentials for the Google Cloud project that owns
# this app — used for both Sign-in-with-Google and Gmail data access).
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — used by the todo generator and per-todo AI assistant.
OPENAI_API_KEY=

# Model per call site (see llm_models.py). Defaults shown; override to trade
# cost against judgement. POLLER runs on every email and wants the cheapest
# current model; ACTIONS writes the instructions an agent then acts on, and is
# one cached call per todo, so it is worth paying for; AGENT is the Agents-SDK
# resolution loop that the deployed container runs, and is where spend can run
# away — turn this one down first if the bill surprises you.
# OPENAI_MODEL_POLLER=gpt-5.6-luna
# OPENAI_MODEL_ACTIONS=gpt-5.6-terra
# OPENAI_MODEL_AGENT=gpt-6-astra

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Local file search root for the per-todo AI assistant (optional).
LOCAL_SEARCH_ROOT=

# Comma-separated list of pollers to run. Defaults to "gmail,fathom,pocket,morning_digest".
# Full set: gmail,fathom,pocket,browser_history,system,morning_digest
# (browser_history and system are macOS-only)
ENABLED_SOURCES=

# Pocket (heypocket.com) action items are fetched through Pocket's hosted MCP
# server; each user's API key lives in Settings. Override only for testing.
# POCKET_MCP_URL=https://public.heypocketai.com/mcp
# POCKET_TIMEOUT_SECONDS=20

# Web Push (browser notifications for new todos, with the suggested actions
# as buttons). Generate once per deployment: python scripts/gen_vapid_keys.py
# All three must be set; otherwise push is off and Settings says so.
# VAPID_SUBJECT is a mailto: the push services can contact.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Resend — used to send the 10am-local morning digest email.
# Requires a verified domain in Resend; RESEND_FROM must be an address on it.
# Create at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=

# IANA timezone used to evaluate the morning-digest 10am-local gate.
# Defaults to Asia/Kolkata. Examples: America/Los_Angeles, Europe/London.
DIGEST_TIMEZONE=

# Browser used for the (opt-in, macOS-only) browser_history poller.
# Supported: chrome, dia. Defaults to chrome if unset.
# To point at a non-default profile, set BROWSER_HISTORY_PATH instead.
BROWSER=

# WhatsApp — talk to the agent from your phone (Settings → WhatsApp), over
# Meta's WhatsApp Cloud API. The first four must be set; otherwise the card
# says so and the webhook is off. From the Meta app dashboard (WhatsApp → API
# Setup): the phone number ID of the sender, an access token (the 24-hour test
# token to try it; a System User token with whatsapp_business_messaging for
# real), the app secret (App settings → Basic), and a verify token you make
# up and paste into the webhook form. Point the webhook at
# <BASE_URL>/whatsapp/webhook (a tunnel such as ngrok when running locally)
# and subscribe it to the "messages" field.
# scripts/setup_whatsapp_meta.sh walks through all of this and fills these in.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
# The WhatsApp Business Account id. Used by scripts/setup_whatsapp_meta.sh to
# subscribe the app to it (without that, Meta delivers nothing) and by
# scripts/create_whatsapp_template.py to submit the notice template below.
# It is also the `entry[].id` on every webhook delivery.
META_WA_WABA_ID=
# Name of the approved message template the new-todo notice falls back to
# when the user has not messaged the app in the last 24 hours — Meta refuses
# free-form text outside that window. `python scripts/create_whatsapp_template.py`
# submits it for approval and waits; leave empty and the notice is dropped then.
META_WA_NOTICE_TEMPLATE=
# Display only: the number users message, shown in the Settings steps.
META_WA_PHONE_NUMBER=
# Set to 1 while on Meta's free test number, which only answers the (up to 5)
# recipients added in API Setup; Settings then tells users to get added first.
META_WA_TEST_NUMBER=

# Where photos sent to the WhatsApp number are saved (one folder per user)
# so the agent can open them by path. Default: ~/.action_inbox_ai/uploads
# UPLOADS_DIR=
# Graph API version for sends. Defaults to v23.0; bump when it ages out.
# META_GRAPH_VERSION=

# Which executor resolves todos. Defaults to "hermes".
#   hermes     — shells out to the local Hermes Agent CLI, which brings its own
#                browser, terminal, file and desktop tools. Needs the `hermes`
#                binary on the host, so it does NOT work in the deployed
#                container — set agents_sdk there.
#   agents_sdk — the in-process OpenAI Agents SDK agent. Works anywhere the
#                OpenAI API is reachable.
# This is only the default. Each user picks their own executor in Settings,
# and the choice is stored per user; Settings only offers executors that are
# ready on this host (Hermes binary found; SDK installed and OPENAI_API_KEY set).
TODO_EXECUTOR=

# --- hermes executor only ---------------------------------------------------

# Path to the Hermes CLI, if it isn't on PATH. Defaults to "hermes".
HERMES_BIN=

# Seconds before a wedged run is killed. Defaults to 600. Resolution is called
# synchronously from the request, so this also bounds how long the UI hangs.
HERMES_TIMEOUT_SECONDS=

# Run Hermes with --yolo (full tool access, no approval prompts). On by default:
# there is no TTY behind a web request, so a run that stops for approval would
# block until the timeout. Set to 0 to use Hermes' own approval rules — expect
# blocked runs unless you have allowlisted what the agent needs.
# Note that with --yolo a full-access agent acts on prompts built from email
# content, which is text you do not control.
HERMES_YOLO=

# Show the agent's browser instead of running it headless. On by default, so you
# can watch a run happen. With browser.use_real_profile on (Hermes' own config)
# the window is a copy of your Chrome profile, signed in to what you are. Set to
# 0 for headless — required on a host with no display, though such a host has no
# Hermes binary either and should be running TODO_EXECUTOR=agents_sdk.
HERMES_BROWSER_HEADED=

# Keep the agent's browser alive between turns (macOS). Hermes attaches to a
# Chrome already running on its profile copy instead of launching and killing
# one per turn, so: no per-turn profile snapshot, your own Chrome is never
# touched, and a login done in the agent's window survives to the next turn.
# Off by default. The copy stops refreshing from your real Chrome once this is
# on; agent_browser.refresh_snapshot() re-copies it when that matters.
HERMES_PERSISTENT_BROWSER=

# Quit your Chrome for the duration of a run and reopen it after (macOS). Only
# needed when Hermes has to snapshot the profile — a running Chrome holds its
# password databases locked and Hermes refuses to launch a browser without
# them. With HERMES_PERSISTENT_BROWSER on this only fires for the very first
# snapshot. Graceful quit only; a Chrome that won't quit is left alone.
HERMES_AUTOCLOSE_CHROME=

# Where Hermes keeps its session store, tailed to show live tool activity during
# a run. Defaults to ~/.hermes/state.db. Only override it if your Hermes home is
# somewhere else; a path that does not exist just means no live trace.
HERMES_STATE_DB=

# Seconds between polls of that store. Defaults to 2.
HERMES_ACTIVITY_POLL_SECONDS=

# Give the Hermes agent the Google Workspace tools (agent/google_mcp) for the
# user and account each turn is for. On by default; needs the server registered
# once with scripts/install_hermes_google_mcp.py. Set to 0 to blank the binding
# (even overriding one this process inherited) — the registered server then
# serves no tools and the agent falls back to the browser for Google.
HERMES_GOOGLE_TOOLS=

# --- agents_sdk executor only -----------------------------------------------

# Opt-in: give the agent a use_browser tool that drives a real, persistent
# Chromium window (via Playwright) for tasks behind a login.
# Off by default — not safe to assume in the deployed container.
# Run `python -m agent.tools.browser.login` once to log into any sites the
# agent should access; cookies persist across runs.
# (The hermes executor has its own browser tools and ignores this.)
ENABLE_BROWSER_AGENT=

