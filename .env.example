# Google OAuth (client credentials for the Google Cloud project that owns
# this app — used for both Sign-in-with-Google and Gmail data access).
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — used by the todo generator and per-todo AI assistant.
OPENAI_API_KEY=

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Local file search root for the per-todo AI assistant (optional).
LOCAL_SEARCH_ROOT=

# Comma-separated list of pollers to run. Defaults to "gmail,fathom,morning_digest".
# Full set: gmail,fathom,browser_history,system,morning_digest
# (browser_history and system are macOS-only)
ENABLED_SOURCES=

# Resend — used to send the 10am-local morning digest email.
# Requires a verified domain in Resend; RESEND_FROM must be an address on it.
# Create at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=

# IANA timezone used to evaluate the morning-digest 10am-local gate.
# Defaults to Asia/Kolkata. Examples: America/Los_Angeles, Europe/London.
DIGEST_TIMEZONE=

# Browser used for the (opt-in, macOS-only) browser_history poller.
# Supported: chrome, dia. Defaults to chrome if unset.
# To point at a non-default profile, set BROWSER_HISTORY_PATH instead.
BROWSER=

# Which executor resolves todos. Defaults to "hermes".
#   hermes     — shells out to the local Hermes Agent CLI, which brings its own
#                browser, terminal, file and desktop tools. Needs the `hermes`
#                binary on the host, so it does NOT work in the deployed
#                container — set agents_sdk there.
#   agents_sdk — the in-process OpenAI Agents SDK agent. Works anywhere the
#                OpenAI API is reachable.
TODO_EXECUTOR=

# --- hermes executor only ---------------------------------------------------

# Path to the Hermes CLI, if it isn't on PATH. Defaults to "hermes".
HERMES_BIN=

# Seconds before a wedged run is killed. Defaults to 600. Resolution is called
# synchronously from the request, so this also bounds how long the UI hangs.
HERMES_TIMEOUT_SECONDS=

# Run Hermes with --yolo (full tool access, no approval prompts). On by default:
# there is no TTY behind a web request, so a run that stops for approval would
# block until the timeout. Set to 0 to use Hermes' own approval rules — expect
# blocked runs unless you have allowlisted what the agent needs.
# Note that with --yolo a full-access agent acts on prompts built from email
# content, which is text you do not control.
HERMES_YOLO=

# Show the agent's browser instead of running it headless. On by default, so you
# can watch a run happen. With browser.use_real_profile on (Hermes' own config)
# the window is a copy of your Chrome profile, signed in to what you are. Set to
# 0 for headless — required on a host with no display, though such a host has no
# Hermes binary either and should be running TODO_EXECUTOR=agents_sdk.
HERMES_BROWSER_HEADED=

# Where Hermes keeps its session store, tailed to show live tool activity during
# a run. Defaults to ~/.hermes/state.db. Only override it if your Hermes home is
# somewhere else; a path that does not exist just means no live trace.
HERMES_STATE_DB=

# Seconds between polls of that store. Defaults to 2.
HERMES_ACTIVITY_POLL_SECONDS=

# --- agents_sdk executor only -----------------------------------------------

# Opt-in: give the agent a use_browser tool that drives a real, persistent
# Chromium window (via Playwright) for tasks behind a login.
# Off by default — not safe to assume in the deployed container.
# Run `python -m agent.tools.browser.login` once to log into any sites the
# agent should access; cookies persist across runs.
# (The hermes executor has its own browser tools and ignores this.)
ENABLE_BROWSER_AGENT=

